# Copy to deploy/vps/.env.vps and fill in. Never commit the filled-in file.

# === Domain / HTTPS (Caddy gets a Let's Encrypt certificate automatically)
# Point an A record for this domain at the VPS before starting the stack.
DOMAIN="postiz.example.com"
ACME_EMAIL="you@example.com"

# === Secrets - generate each with: openssl rand -hex 32
JWT_SECRET="change-me"
POSTGRES_USER="postiz"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="postiz"
TEMPORAL_DB_PASSWORD="change-me"

# === Registration
DISABLE_REGISTRATION="false"
# If set, new users must confirm their email (https://resend.com)
#RESEND_API_KEY=""
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""

# === Storage: "local" keeps media in the postiz-uploads volume.
# Social platforms (Instagram, TikTok, ...) fetch media from your public URL, so the domain must be reachable.
STORAGE_PROVIDER="local"
# Or Cloudflare R2:
#STORAGE_PROVIDER="cloudflare"
#CLOUDFLARE_ACCOUNT_ID=""
#CLOUDFLARE_ACCESS_KEY=""
#CLOUDFLARE_SECRET_ACCESS_KEY=""
#CLOUDFLARE_BUCKETNAME=""
#CLOUDFLARE_BUCKET_URL=""
#CLOUDFLARE_REGION="auto"

# === AI (used by Postiz's existing AI features)
OPENAI_API_KEY=""

# === Studio (trend -> script -> video -> scheduled posts)
# Each organization adds its own provider keys in Studio > API keys.
# Set to "true" to let organizations without their own key use the server keys
# below (you pay for everything they generate, only do this for your own team).
STUDIO_SHARED_KEYS="false"
#FAL_KEY=""
#REPLICATE_API_TOKEN=""
#GEMINI_API_KEY=""
#RUNWAYML_API_SECRET=""
#LUMAAI_API_KEY=""
#ELEVENSLABS_API_KEY=""
#PEXELS_API_KEY=""
#YOUTUBE_DATA_API_KEY=""
#X_BEARER_TOKEN=""
# Model used to write the scripts (default gpt-4.1)
#STUDIO_SCRIPT_MODEL=""

# === Social platform apps. Each needs a developer app on the platform with the
# OAuth redirect URL https://<DOMAIN>/integrations/social/<provider>
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_BUSINESS_CLIENT_ID=""
TIKTOK_BUSINESS_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""

# === Payments (optional, for selling plans to your users)
#STRIPE_PUBLISHABLE_KEY=""
#STRIPE_SECRET_KEY=""
#STRIPE_SIGNING_KEY=""

API_LIMIT=30
